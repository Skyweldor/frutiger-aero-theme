  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b8f2e8cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage (import, export, default, const, let, function)",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#8ef4ff"
      }
    },
    {
      "name": "Control Flow Keywords & Special Identifiers (return, this, throw, await, yield)",
      "scope": [
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.loop",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#ffa6c2"
      }
    },
    {
      "name": "Import / Export / From / As Keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#98f6ff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffd46b"
      }
    },
    {
      "name": "String Escape & RegExp",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9effd6"
      }
    },
    {
      "name": "Functions & Method Declarations / Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e8ff7a"
      }
    },
    {
      "name": "Classes, Types, Interfaces & Namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#9effdc"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Constant Variables & Properties",
      "scope": [
        "variable.other.constant",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#d8f7ff"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c8f4ff"
      }
    },
    {
      "name": "Booleans, Numbers & Built-in Constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a8f7ff"
      }
    },
    {
      "name": "Operators & Arrow Functions",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#e0f8ff"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#98f5e1"
      }
    },
    {
      "name": "HTML / JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffe484"
      }
    },
    {
      "name": "CSS Selectors, Properties & Values",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#e8ff7a"
      }
    },
    {
      "name": "CSS Property Names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#98f6ff"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8ef4ff"
      }
    },
    {
      "name": "Markdown Headings & Links",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#e8ff7a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold / Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Brackets",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#def8ff"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#e8ff7a",
    "method": "#e8ff7a",
    "class": "#9effdc",
    "interface": "#9effdc",
    "type": "#9effdc",
    "parameter": "#c8f4ff",
    "variable": "#ffffff",
    "variable.readonly": "#d8f7ff",
    "property": "#d8f7ff",
    "keyword": "#8ef4ff",
    "string": "#ffd46b",
    "number": "#a8f7ff",
    "regexp": "#9effd6"
  }
}
